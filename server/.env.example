# Copia este archivo a "server/.env" para correr el backend de pagos localmente.

# Access Token de tu cuenta de Mercado Pago Developers
# https://www.mercadopago.cl/developers/panel/app -> Credenciales de prueba o de producción
MP_ACCESS_TOKEN=

# URL pública donde corre el frontend (para las back_urls de Mercado Pago)
PUBLIC_APP_URL=http://localhost:5173

PORT=4000
