# ---------------------------------------------------------------------------
# Copia este archivo a ".env" (frontend) y ajusta los valores.
# El sitio funciona igual sin configurar nada (modo demo con datos de ejemplo).
# ---------------------------------------------------------------------------

# WhatsApp: número de contacto (formato internacional, solo números)
VITE_WHATSAPP_NUMBER=56900000000

# Clave del panel de administración en modo demo (sin Firebase)
VITE_ADMIN_PASSWORD=admin123

# URL del backend de pagos (server/ o api/). Déjalo vacío para modo demo.
# Ejemplo si corres el backend local: VITE_API_URL=http://localhost:4000
VITE_API_URL=

# --- Firebase (opcional, para que el stock persista en la nube) -------------
# Crea un proyecto gratis en https://console.firebase.google.com,
# habilita "Firestore Database" y "Authentication > Email/Password",
# y copia estos valores desde Configuración del proyecto > Tus apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
